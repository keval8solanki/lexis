{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@core": [
        "./src/core"
      ],
      "@core/*": [
        "./src/core/*"
      ],
      "@/*": [
        "./src/modules/*"
      ]
    },
    "types": [
      "bun"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  }
}
